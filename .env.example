# ── AWS Bedrock (policy reasoning) ──────────────────────────────────────────────
# Credentials: either set these, or leave them out and let boto3 use ~/.aws.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
# Bedrock model id (Sonnet for accuracy, Haiku for speed/cost — both pass the scenario):
GOV_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ── Streaming STT ───────────────────────────────────────────────────────────────
# Set this to use true Deepgram streaming; leave empty to use the local faster-whisper fallback.
DEEPGRAM_API_KEY=

# ── Phase 3: voiceprint consent ─────────────────────────────────────────────────
# Set to 1 to identify speakers by voice and gate consent BEFORE transcription
# (enrolls the scenario speakers at startup). Empty = manual speaker selection.
GOV_VOICEPRINT=

# ── Where to persist governed decisions (the NestJS product API) ─────────────────
NEST_API_URL=http://localhost:4000
